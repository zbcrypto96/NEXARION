# Railway / local development environment variables for NEXARION

PAPER_MODE=true
START_CAPITAL=1000

# If you use a normal RPC provider:
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Recommended Helius event scanning key
HELIUS_API_KEY=

# Telegram notification settings
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

COPYTRADE_SEED_WALLETS=
TRADE_REPORT_ENABLED=true

# If you want to use Helius RPC directly, this is also supported:
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<your-key>
# HELIUS_API_KEY=<your-key>
